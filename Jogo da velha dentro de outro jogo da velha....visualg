algoritmo "Jogo da Velha dentro do Jogo da Velha"

var

   tab: vetor[1..2, 1..9] de caractere


   linhas: vetor[1..8, 1..3] de inteiro

   casa, pos, jogadas, limite: inteiro
   escolhedor, vez, resultado: caractere
   fim: logico
   casaEscolhida: inteiro 

// Guarda uma combinacao vencedora (n = numero da linha; a, b, c = casas)
procedimento defLinha(n, a, b, c: inteiro)
inicio
   linhas[n, 1] <- a
   linhas[n, 2] <- b
   linhas[n, 3] <- c
fimprocedimento

procedimento preparaLinhas
inicio
   defLinha(1, 1, 2, 3)   // linha de cima
   defLinha(2, 4, 5, 6)   // linha do meio
   defLinha(3, 7, 8, 9)   // linha de baixo
   defLinha(4, 1, 4, 7)   // coluna esquerda
   defLinha(5, 2, 5, 8)   // coluna do meio
   defLinha(6, 3, 6, 9)   // coluna direita
   defLinha(7, 1, 5, 9)   // diagonal principal
   defLinha(8, 3, 5, 7)   // diagonal secundaria
fimprocedimento

// Esvazia um tabuleiro (t = 1 pequeno, t = 2 grande)
procedimento limpa(t: inteiro)
var i: inteiro
inicio
   para i de 1 ate 9 faca
      tab[t, i] <- " "
   fimpara
fimprocedimento

// Desenha um tabuleiro, cada casa vazia é representada por um numero
procedimento mostra(t: inteiro)
var i: inteiro
inicio
   para i de 1 ate 9 faca
      se tab[t, i] = " " entao
         escreva(" ", i, " ")
      senao
         escreva(" ", tab[t, i], " ")
      fimse
      se (i mod 3) = 0 entao
         escreval("")
         se i < 9 entao
            escreval("---+---+---")
         fimse
      senao
         escreva("|")
      fimse
   fimpara
fimprocedimento

// alterna para o outro jogador
funcao outro(j: caractere): caractere
inicio
   se j = "X" entao
      retorne "O"
   senao
      retorne "X"
   fimse
fimfuncao

// Verifica se algum jogador completou alguma linha
funcao ganhou(t: inteiro, j: caractere): logico
var n: inteiro
    r: logico
inicio
   r <- falso
   para n de 1 ate 8 faca
      se (tab[t, linhas[n, 1]] = j) e (tab[t, linhas[n, 2]] = j) e (tab[t, linhas[n, 3]] = j) entao
         r <- verdadeiro
      fimse
   fimpara
   retorne r
fimfuncao

// Verifica se o tabuleiro nao tem mais casas vazias
funcao cheio(t: inteiro): logico
var i: inteiro
    r: logico
inicio
   r <- verdadeiro
   para i de 1 ate 9 faca
      se tab[t, i] = " " entao
         r <- falso
      fimse
   fimpara
   retorne r
fimfuncao

// No tabuleiro grande, uma linha ainda pode ser conquistada enquanto nao tiver X e O juntos
// Caso todas as casas ja estao ocupadas, ninguem ganha, empate
funcao vitoriaPossivel(): logico
var n, k: inteiro
    temX, temO, r: logico
inicio
   r <- falso
   para n de 1 ate 8 faca
      temX <- falso
      temO <- falso
      para k de 1 ate 3 faca
         se tab[2, linhas[n, k]] = "X" entao
            temX <- verdadeiro
         fimse
         se tab[2, linhas[n, k]] = "O" entao
            temO <- verdadeiro
         fimse
      fimpara
      se nao (temX e temO) entao
         r <- verdadeiro
      fimse
   fimpara
   retorne r
fimfuncao

// Pede para que o jogador da vez, que selecione apenas um numero de 1 a 9
procedimento escolheCasa(t: inteiro, j: caractere)
var c: inteiro
    valida: logico
inicio
   repita
      se t = 2 entao
         escreva("Jogador ", j, ", escolha a casa do tabuleiro GRANDE (1 a 9): ")
      senao
         escreva("Jogador ", j, ", escolha a posicao no tabuleiro pequeno (1 a 9): ")
      fimse
      leia(c)
      valida <- falso
      // verifica se esta entre 1 e 9, somente depois verifica o vetor
      se (c >= 1) e (c <= 9) entao
         se tab[t, c] = " " entao
            valida <- verdadeiro
         senao
            escreval("Essa casa ja esta ocupada! Escolha outra.")
         fimse
      senao
         escreval("Numero invalido! Digite de 1 a 9.")
      fimse
   ate valida
   casaEscolhida <- c    
fimprocedimento

inicio
   preparaLinhas
   limpa(2)
   limite <- 100       // regra: maximo 100 jogadas no total
   jogadas <- 0
   escolhedor <- "X"   // X começa o jogo escolhendo a casa do tabuleiro grande
   fim <- falso

   escreval("===== JOGO DA VELHA DENTRO DO JOGO DA VELHA =====")

   enquanto nao fim faca
      // Escolha da posição da casa grande
      escreval("")
      escreval("TABULEIRO GRANDE:")
      mostra(2)
      escolheCasa(2, escolhedor)
      casa <- casaEscolhida

      // Tabuleiro pequeno dentro da casa escolhida no tabuleiro grande
      limpa(1)
      vez <- escolhedor      // o jogador da vez que escolheu a casa no grande, começa a rodada no tabuleiro menor
      resultado <- " "       
      enquanto (resultado = " ") e (jogadas < limite) faca
         escreval("")
         escreval("Jogo pequeno na casa ", casa, " do tabuleiro grande:")
         mostra(1)
         escolheCasa(1, vez)
         pos <- casaEscolhida
         tab[1, pos] <- vez
         jogadas <- jogadas + 1
         se ganhou(1, vez) entao
            resultado <- vez
         senao
            se cheio(1) entao
               resultado <- "V"
            senao
               vez <- outro(vez)
            fimse
         fimse
      fimenquanto

      escreval("")
      mostra(1)

      // Resultado do tabuleiro pequeno
      se resultado = "V" entao
         escreval("A casa ", casa, " continua vazia e pode ser escolhida de novo.")
      senao
         se resultado <> " " entao
            tab[2, casa] <- resultado
            escreval("Jogador ", resultado, " venceu e conquistou a casa ", casa, "!")
         fimse
      fimse

      // verifica se a partida acabou ou não
      se ganhou(2, "X") ou ganhou(2, "O") entao
         escreval("")
         mostra(2)
         escreval("*** JOGADOR ", resultado, " VENCEU A PARTIDA! ***")
         fim <- verdadeiro
      senao
         se nao vitoriaPossivel() entao
            escreval("")
            mostra(2)
            escreval("*** DEU VELHA NO TABULEIRO GRANDE: Empate... ***")
            fim <- verdadeiro
         senao
            se jogadas >= limite entao
               escreval("")
               mostra(2)
               escreval("*** LIMITE DE ", limite, " JOGADAS ATINGIDO: ninguem venceu. ***")
               fim <- verdadeiro
            fimse
         fimse
      fimse

      // Apos o jogo do tabuleiro menor concluir, a escolha da proxima casa no tabuleiro grande passa para o outro jogador
      escolhedor <- outro(escolhedor)
   fimenquanto

   escreval("Total de jogadas: ", jogadas)
fimalgoritmo